#!/usr/bin/env bash
# Omarchy theme-set hook: tell the running omaclackd which theme was applied.
# The daemon plays a confirmation key and the shell switches to the pack you
# bound to this theme (panel: "use this pack for theme ...").
# Install: omarchy hook install theme-set /path/to/omaclack/tools/omaclack-theme-hook
slug=${1:-}
sock="${XDG_RUNTIME_DIR:-/tmp}/omaclack/ctl.sock"
[[ -S $sock ]] || exit 0
python3 - "$sock" "$slug" <<'PY' 2>/dev/null || true
import json, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(1.0)
s.connect(sys.argv[1])
s.sendall((json.dumps({"cmd": "theme", "slug": sys.argv[2]}) + "\n").encode())
PY
