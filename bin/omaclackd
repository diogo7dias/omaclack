#!/bin/sh
# Omaclack daemon launcher. Prefers the Rust build for this CPU (in-process
# PipeWire playback, ~18 ms key-to-sound) and falls back to the Python daemon
# (one pw-play per key, ~48 ms). Same protocol either way.
here=$(dirname "$0")
bin="$here/omaclackd-$(uname -m)"
# OMACLACK_PYTHON forces the stdlib fallback even when a matching Rust binary
# is present, for testing the fallback path on a CPU that also ships a build.
if [ -x "$bin" ] && [ -z "$OMACLACK_PYTHON" ]; then
  exec "$bin" "$@"
fi
exec python3 "$here/omaclackd.py" "$@"
