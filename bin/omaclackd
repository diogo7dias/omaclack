#!/usr/bin/env python3
"""omaclackd: keyboard sound daemon for the Omaclack Omarchy plugin.

Reads /dev/input/event* directly and spawns one short-lived `pw-play` per
keypress on a per-key Opus file. pw-play auto-connects to PipeWire, decodes
via libsndfile and exits when the sample ends; nothing stays resident but
this process sleeping in select().

Stdlib only. No logging, no network. Child of omarchy-shell; dies with it.
"""

import fcntl
import json
import os
import select
import signal
import socket
import struct
import subprocess
import sys
import time

# ---------------------------------------------------------------- constants

EV_KEY = 0x01
KEY_MAX_KEYBOARD = 0x100
BTN_MOUSE_MIN, BTN_MOUSE_MAX = 0x110, 0x117

DEBOUNCE_MS = 30.0
RESCAN_S = 3.0

MAX_CONCURRENT = 16  # cap on simultaneous pw-play processes
SAMPLE_EXT = (".opus", ".ogg", ".flac", ".wav")

INPUT_EVENT = struct.Struct("llHHi")

HERE = os.path.dirname(os.path.abspath(__file__))
SOUNDS_DIR = os.path.join(os.path.dirname(HERE), "sounds")
MOUSE_DIR = os.path.join(SOUNDS_DIR, "mouse")


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return os.path.join(base, "omaclack")


# ---------------------------------------------------------------- packs

def _default_file(path):
    for ext in SAMPLE_EXT:
        f = os.path.join(path, "default" + ext)
        if os.path.isfile(f):
            return f
    return None


def pack_meta(name, root=SOUNDS_DIR):
    """pack.json contents plus id; name falls back to the folder name."""
    meta = {}
    try:
        with open(os.path.join(root, name, "pack.json")) as f:
            meta = json.load(f)
    except (OSError, ValueError):
        pass
    return {"id": name, "name": str(meta.get("name") or name),
            "credit": str(meta.get("credit") or ""), "source": str(meta.get("source") or "")}


class Pack:
    """Maps keycodes to sample files. <code>.<ext> wins, then pack.json "keys",
    then default.<ext>. Files are only stat'ed here; pw-play reads them."""

    def __init__(self, name, root=SOUNDS_DIR):
        self.name = name
        path = os.path.join(root, name)
        if not os.path.isdir(path):
            raise FileNotFoundError(path)
        self.default = _default_file(path)
        if self.default is None:
            raise FileNotFoundError(os.path.join(path, "default.opus"))
        self.files = {}
        for fn in os.listdir(path):
            stem, ext = os.path.splitext(fn)
            if ext in SAMPLE_EXT and stem.isdigit():
                self.files[int(stem)] = os.path.join(path, fn)
        try:
            with open(os.path.join(path, "pack.json")) as f:
                keys = json.load(f).get("keys") or {}
        except (OSError, ValueError):
            keys = {}
        for code, fn in keys.items():
            f = os.path.join(path, os.path.basename(str(fn)))
            if str(code).isdigit() and int(code) not in self.files and os.path.isfile(f):
                self.files[int(code)] = f

    def sample_for(self, code):
        return self.files.get(code, self.default)


def list_packs(root=SOUNDS_DIR):
    if not os.path.isdir(root):
        return []
    return sorted(d for d in os.listdir(root) if _default_file(os.path.join(root, d)))


def first_or_none(names, preferred):
    return preferred if preferred in names else (names[0] if names else None)


# ---------------------------------------------------------------- playback

class OneShotPlayer:
    """One pw-play per sample; gain is passed as --volume so no audio touches Python."""

    def __init__(self):
        self.muted = False
        self.live = []          # in-flight pw-play processes
        self.stream_ok = True   # last spawn attempt succeeded

    def reap(self):
        self.live = [p for p in self.live if p.poll() is None]

    def play(self, path, volume=1.0):
        g = 0.0 if self.muted else max(0.0, min(1.0, volume))
        if g == 0.0 or not path:
            return
        self.reap()
        if len(self.live) >= MAX_CONCURRENT:
            return
        self._spawn(["pw-play", "--volume", "%.3f" % g, path])

    def _spawn(self, cmd):
        try:
            self.live.append(subprocess.Popen(cmd, stdin=subprocess.DEVNULL,
                                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
            self.stream_ok = True
        except OSError:
            self.stream_ok = False


# ---------------------------------------------------------------- key filtering

class KeyFilter:
    """Drops repeats of the same key inside the debounce window. Every key
    sounds on its own, modifiers included."""

    def __init__(self, debounce_ms=DEBOUNCE_MS):
        self.debounce_ms = debounce_ms
        self.last = {}

    def on_press(self, code, now):
        t = self.last.get(code)
        if t is not None and now - t < self.debounce_ms:
            return False
        self.last[code] = now
        return True


# ---------------------------------------------------------------- controller

class Controller:
    def __init__(self, player, pack_root=SOUNDS_DIR, mouse_root=MOUSE_DIR):
        self.player = player
        self.pack_root = pack_root
        self.mouse_root = mouse_root
        self.pack = None
        self.mouse_pack = None
        self.mouse_enabled = True
        self.enabled = True
        self.volume = 0.7        # keyboard
        self.mouse_volume = 0.7
        first = first_or_none(list_packs(pack_root), "mx-blue")
        if first:
            self.load_pack(first)
        first = first_or_none(list_packs(mouse_root), "logitech")
        if first:
            self.load_mouse_pack(first)

    def load_pack(self, name):
        self.pack = Pack(name, self.pack_root)
        return self.pack.name

    def load_mouse_pack(self, name):
        self.mouse_pack = Pack(name, self.mouse_root)
        return self.mouse_pack.name

    def status(self):
        return {
            "ok": True,
            "pack": self.pack.name if self.pack else None,
            "packs": [pack_meta(p, self.pack_root) for p in list_packs(self.pack_root)],
            "mouse_pack": self.mouse_pack.name if self.mouse_pack else None,
            "mouse_packs": [pack_meta(p, self.mouse_root) for p in list_packs(self.mouse_root)],
            "volume": int(round(self.volume * 100)),
            "mouse_volume": int(round(self.mouse_volume * 100)),
            "muted": self.player.muted,
            "enabled": self.enabled,
            "mouse": self.mouse_enabled,
            "stream": self.player.stream_ok,
        }

    def play(self, code, t0=None):
        if not self.enabled:
            return None
        pack, volume = self.pack, self.volume
        if code >= KEY_MAX_KEYBOARD:
            if not self.mouse_enabled:
                return None
            pack, volume = self.mouse_pack or pack, self.mouse_volume
        if pack is None:
            return None
        self.player.play(pack.sample_for(code), volume)
        t1 = time.monotonic()
        return round((t1 - (t0 if t0 is not None else t1)) * 1000.0, 2)

    def handle(self, msg):
        cmd = msg.get("cmd")
        try:
            if cmd == "play":
                t0 = time.monotonic()
                lat = self.play(int(msg.get("key", 0)), t0)
                return {"ok": lat is not None, "latency_ms": lat}
            if cmd == "load":
                return {"ok": True, "pack": self.load_pack(str(msg.get("pack", "")))}
            if cmd == "mousepack":
                return {"ok": True, "mouse_pack": self.load_mouse_pack(str(msg.get("pack", "")))}
            if cmd == "volume":
                v = max(0, min(100, int(msg.get("value", 70))))
                self.volume = v / 100.0
                return {"ok": True, "volume": v}
            if cmd == "mousevolume":
                v = max(0, min(100, int(msg.get("value", 70))))
                self.mouse_volume = v / 100.0
                return {"ok": True, "mouse_volume": v}
            if cmd == "mute":
                self.player.muted = bool(msg.get("toggle", True))
                return {"ok": True, "muted": self.player.muted}
            if cmd == "enable":
                self.enabled = bool(msg.get("value", True))
                return {"ok": True, "enabled": self.enabled}
            if cmd == "mouse":
                self.mouse_enabled = bool(msg.get("value", True))
                return {"ok": True, "mouse": self.mouse_enabled}
            if cmd == "status":
                return self.status()
            if cmd == "ping":
                return {"ok": True, "pong": msg.get("t")}
            if cmd == "quit":
                return {"ok": True, "quit": True}
            return {"ok": False, "error": "unknown cmd"}
        except (FileNotFoundError, ValueError) as e:
            return {"ok": False, "error": str(e)}


# ---------------------------------------------------------------- evdev

class InputReader:
    def __init__(self):
        self.fds = {}
        self.last_scan = 0.0
        self.denied = False

    def scan(self, now):
        if now - self.last_scan < RESCAN_S:
            return
        self.last_scan = now
        try:
            names = os.listdir("/dev/input")
        except OSError:
            return
        open_paths = set(self.fds.values())
        self.denied = False
        for n in names:
            if not n.startswith("event"):
                continue
            p = "/dev/input/" + n
            if p in open_paths:
                continue
            try:
                fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
                self.fds[fd] = p
            except PermissionError:
                self.denied = True
            except OSError:
                pass

    def read_presses(self, fd):
        try:
            buf = os.read(fd, INPUT_EVENT.size * 64)
        except BlockingIOError:
            return
        except OSError:
            self.close(fd)
            return
        if not buf:
            self.close(fd)
            return
        for off in range(0, len(buf) - INPUT_EVENT.size + 1, INPUT_EVENT.size):
            _, _, etype, code, value = INPUT_EVENT.unpack_from(buf, off)
            if etype != EV_KEY or value != 1:
                continue
            if code < KEY_MAX_KEYBOARD or BTN_MOUSE_MIN <= code <= BTN_MOUSE_MAX:
                yield code

    def close(self, fd):
        self.fds.pop(fd, None)
        try:
            os.close(fd)
        except OSError:
            pass


# ---------------------------------------------------------------- server

class CtlServer:
    def __init__(self, path):
        self.path = path
        self.lockfd = None
        self.srv = None
        self.client = None
        self.rbuf = b""

    def start(self):
        os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
        self.lockfd = os.open(self.path + ".lock", os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(self.lockfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            sys.exit(2)
        try:
            os.unlink(self.path)
        except FileNotFoundError:
            pass
        self.srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.srv.bind(self.path)
        os.chmod(self.path, 0o600)
        self.srv.listen(1)
        self.srv.setblocking(False)

    def accept(self):
        try:
            c, _ = self.srv.accept()
        except (BlockingIOError, OSError):
            return
        if self.client:
            try:
                self.client.close()
            except OSError:
                pass
        c.setblocking(False)
        self.client = c
        self.rbuf = b""

    def read_messages(self):
        try:
            data = self.client.recv(65536)
        except BlockingIOError:
            return []
        except OSError:
            data = b""
        if not data:
            self.drop_client()
            return []
        self.rbuf += data
        out = []
        while b"\n" in self.rbuf:
            line, self.rbuf = self.rbuf.split(b"\n", 1)
            line = line.strip()
            if not line:
                continue
            try:
                out.append(json.loads(line))
            except ValueError:
                out.append({"cmd": "__bad__"})
        return out

    def send(self, obj):
        if not self.client:
            return
        try:
            self.client.sendall((json.dumps(obj, separators=(",", ":")) + "\n").encode())
        except OSError:
            self.drop_client()

    def drop_client(self):
        if self.client:
            try:
                self.client.close()
            except OSError:
                pass
        self.client = None

    def close(self):
        self.drop_client()
        if self.srv:
            self.srv.close()
        try:
            os.unlink(self.path)
        except OSError:
            pass


class PipeChannel:
    """JSON-lines over the stdin/stdout pipe pair the shell spawned us with."""

    def __init__(self):
        self.rbuf = b""
        self.eof = False
        self.out = os.fdopen(os.dup(1), "wb", buffering=0)
        # Our stdout is now the shell's event feed; nothing else may print there.
        sys.stdout = sys.stderr

    def read_messages(self):
        try:
            data = os.read(0, 65536)
        except BlockingIOError:
            return []
        except OSError:
            data = b""
        if not data:
            self.eof = True
            return []
        self.rbuf += data
        out = []
        while b"\n" in self.rbuf:
            line, self.rbuf = self.rbuf.split(b"\n", 1)
            line = line.strip()
            if not line:
                continue
            try:
                out.append(json.loads(line))
            except ValueError:
                out.append({"cmd": "__bad__"})
        return out

    def send(self, obj):
        try:
            self.out.write((json.dumps(obj, separators=(",", ":")) + "\n").encode())
        except OSError:
            self.eof = True


# ---------------------------------------------------------------- main loop

def main(argv):
    sock_path = os.path.join(runtime_dir(), "ctl.sock")
    for a in argv[1:]:
        if a.startswith("--socket="):
            sock_path = a.split("=", 1)[1]

    player = OneShotPlayer()
    ctl = Controller(player)
    keys = KeyFilter()
    inputs = InputReader()
    server = CtlServer(sock_path)
    server.start()

    running = True

    def on_signal(*_):
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGHUP, on_signal)

    # When stdin is a pipe (spawned by omarchy-shell) it doubles as the control
    # channel: JSON lines in on stdin, replies and key events out on stdout.
    # EOF on stdin means the shell is gone, so we exit with it.
    parent_fd = None
    pipe = None
    try:
        import stat as _stat
        if _stat.S_ISFIFO(os.fstat(0).st_mode):
            parent_fd = 0
            pipe = PipeChannel()
            pipe.send({"evt": "hello", **ctl.status(), "denied": inputs.denied})
    except OSError:
        pass

    def emit(obj):
        if server.client:
            server.send(obj)
        if pipe is not None:
            pipe.send(obj)

    while running:
        now = time.monotonic()
        inputs.scan(now)
        rl = list(inputs.fds) + [server.srv]
        if server.client:
            rl.append(server.client)
        if parent_fd is not None:
            rl.append(parent_fd)
        try:
            ready, _, _ = select.select(rl, [], [], RESCAN_S)
        except (InterruptedError, OSError):
            continue
        now = time.monotonic()
        now_ms = now * 1000.0
        for fd in ready:
            if fd is server.srv:
                server.accept()
                server.send({"evt": "hello", **ctl.status(), "denied": inputs.denied})
            elif server.client is not None and fd is server.client:
                for msg in server.read_messages():
                    resp = ctl.handle(msg)
                    resp["id"] = msg.get("id")
                    server.send(resp)
                    if resp.get("quit"):
                        running = False
            elif fd == parent_fd:
                msgs = pipe.read_messages()
                if pipe.eof:
                    running = False
                for msg in msgs:
                    resp = ctl.handle(msg)
                    resp["id"] = msg.get("id")
                    pipe.send(resp)
                    if resp.get("quit"):
                        running = False
            else:
                for code in inputs.read_presses(fd):
                    if not keys.on_press(code, now_ms):
                        continue
                    lat = ctl.play(code, now)
                    if lat is not None:
                        emit({"evt": "key", "key": code, "latency_ms": lat})

    server.close()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
